# Backend (universal-backend) URL, without trailing slash
VITE_BACKEND_URL=http://localhost:3000
# Optional: arbiter wallet pre-filled in the create form
VITE_DEFAULT_ARBITER=
# Optional: Solana RPC (defaults to public devnet)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: wallet receiving orders from the demo merch shop
VITE_SHOP_SELLER=7oT6f8Pv4fEoqKWDsdSenJs77AMR5dB9bCNJ7DYvEqsv
# Optional demo mode: base58 secret keys of devnet-only demo wallets. When set, a
# role switcher (Kupujący / Sprzedający / Arbiter) signs with them without Phantom.
# These end up in the public JS bundle — never use wallets holding real funds.
VITE_DEMO_BUYER_KEY=
VITE_DEMO_SELLER_KEY=
VITE_DEMO_ARBITER_KEY=
